# 高德开放平台 Web 服务 Key（去 https://lbs.amap.com 申请）
AMAP_KEY=your_amap_key_here

# 高德 API 基础地址（一般无需改）
AMAP_BASE=https://restapi.amap.com/v3

# 携程开放平台分销（景点门票）——可选，不填自动走示例数据（来源标 ctrip_mock）
# 申请入口：https://openapi.ctrip.com → 注册分销合作 → 获取 AppKey / AppSecret
CTRIP_API_KEY=
CTRIP_API_SECRET=
# 一般不用改
CTRIP_API_BASE=https://openapi.ctrip.com

# 后端端口
PORT=8787

# lark-cli 可执行文件路径（如已在 PATH 中可留空）
LARK_CLI_BIN=lark-cli

# lark-cli profile（如有多账号，指定 profile；默认空）
LARK_PROFILE=

# 默认城市 adcode（天气查询用；北京=110000，上海=310000，深圳=440300）
DEFAULT_CITY_ADCODE=110000

# 日程默认拉取范围（小时）
AGENDA_HOURS=24

# 缓存：天气缓存分钟数
WEATHER_CACHE_MIN=60
# 缓存：路线缓存分钟数
ROUTE_CACHE_MIN=15

# 个人访问保护：默认必须配置；真实密码只由你在本机 npm run auth:hash 安全输入
AUTH_PASSWORD_HASH=
# 生产必须明确设为 production；缺少 hash 或 HTTPS PUBLIC_ORIGIN 将拒绝启动
NODE_ENV=development
# 生产例：https://time.example.com（无路径/尾斜杠），反向代理必须保留 Host
PUBLIC_ORIGIN=
# 默认只监听本机；如用容器内部网络绑定，必须另行用防火墙隔离后端
HOST=127.0.0.1
# 仅非生产+回环监听可 true；绝不可把绕过鉴权的开发服务器暴露公网
AUTH_DISABLED=false
# 运行时数据的绝对目录，生产需挂持久卷；空值使用项目根 .run-data
DATA_DIR=
